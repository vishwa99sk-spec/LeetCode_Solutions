class Solution(object):
    def addBinary(self, a, b):
        """
        :type a: str
        :type b: str
        :rtype: str
        """
        result=[]
        i,j=len(a)-1,len(b)-1
        carry=0

        while i>=0 or j>=0 or carry:
            if i>=0 or j>=0:
                total=carry+int(a[i])+int(b[j])
                result.append(str(total%2))
                carry=total//2
                i-=1
                j-=1
        return "".join(reversed(result))

            
