class Solution(object):
    def myAtoi(self, s):
        """
        :type s: str
        :rtype: int
        """
        s=s.strip()

        if not s:
            return 0

            

        result=0
        sign=1

        if s[0]=='-' or s[0]=='+':
            if s[0]=='-':
                sign=-1

            s=s[1: ]

        for ch in s:
            if not ch.isdigit():
                break
            result=result*10+int(ch)

        result=result*sign

        if result>2**31-1:
            return 2**31-1
        elif result<-2**31:
            return -2**31


        return result
    
       
  
   
      


        

    
