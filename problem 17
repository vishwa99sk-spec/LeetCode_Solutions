class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        stack=[]

        hs={
            ")" : "(",
            "}" : "{",
            "]" : "["
        }

        

        for i in s:

            if i not in hs:
                stack.append(i)
            else:
                if not stack:
                    return False
                else:
                    popped=stack.pop()
                    if popped != hs[i]:
                        return False
        return not stack
