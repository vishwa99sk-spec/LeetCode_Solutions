class Solution(object):
    def hasPathSum(self, root, targetSum):
        def search(node,sum):
    
       
      
        
       

       
  




            if not node:
                return False

            sum = sum + node.val

            if not node.left and not node.right:
                return sum == targetSum

            return (search(node.left, sum) or
                    search(node.right, sum))

        return search(root, 0)
        
