class Solution(object):
    def longestCommonPrefix(self, strs):
        """
        :type strs: List[str]
        :rtype: str
        """
        min_strs=min(strs)
        max_strs=max(strs)
        result=""

        for i in range(len(min_strs)):
            if min_strs[i]==max_strs[i]:
                result +=min_strs[i]
            else:
                return result

        return result
        
